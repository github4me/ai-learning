      "b",
      "c",
      "d",
      "e",
      "f",
      "g",
      "h",
      "i",
      "j",
      "k",
      "l",
      "m",
      "n",
      "o",
      "p",
      "q",
      "r",
      "s",
      "t",
      "u",
      "v",
      "w",
      "x",
      "y",
      "z",
      " ",
      ".",
      ",",
      "\n"
    ],
    "mode": "character"
  },
  "tie_weights": false,
  "measurement": "All fixed train/validation windows in eval/no_grad; no dropout; mean CE per effective target"
